DB_CONNECTION=mysql
SANCTUM_STATEFUL_DOMAINS=localhost:9000
DB_TRUST_SERVER_CERTIFICATE=true

DEFAULT_PASSWORD="Senha_nada_segura123"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
